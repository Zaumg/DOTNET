@model List<ExerciciosMVC.Models.Evento>


@{
    ViewData["Title"] = "Eventos";
}


<h1>Eventos cadastrados</h1>


<p>
    <a asp-action="Criar" class="btn btn-primary">
        Cadastrar evento
    </a>


    <a asp-action="Buscar" class="btn btn-secondary">
        Buscar eventos
    </a>
</p>


@if (Model.Count == 0)
{
    <p>Nenhum evento cadastrado.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Local</th>
                <th>Data</th>
                <th>Vagas</th>
                <th>Ingresso</th>
                <th>Detalhes</th>
            </tr>
        </thead>


        <tbody>
            @foreach (var evento in Model)
            {
                <tr>
                    <td>@evento.Nome</td>
                    <td>@evento.Local</td>
                    <td>@evento.DataEvento.ToString("dd/MM/yyyy")</td>
                    <td>@evento.QuantidadeVagas</td>
                    <td>@evento.ValorIngresso.ToString("C")</td>
                    <td>
                        <a asp-action="Detalhes"
                           asp-route-id="@evento.Id">
                            Ver detalhes
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}